# Blaue Stunde on Hostinger (LiteSpeed/Apache, D-12). Uploaded with the site from the
# workspace build (tools/build-dist.mjs); only what is uploaded is public.

# one address: https and without www (D-83), in one redirect
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# the site's own page for missing addresses (404.html, absolute paths)
ErrorDocument 404 /404.html

# no directory listings; no dotfiles (.htaccess, .htpasswd, .git)
Options -Indexes
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# STAGING: keep search engines out until Impressum and Datenschutz are final (C1, D-01).
# tools/build-dist.mjs --launch leaves this block out (from "# STAGING" to its </IfModule>)
# and writes the launch robots.txt and sitemap.xml instead of the staging robots.txt.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# compression (LiteSpeed also compresses on its own)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

AddType application/manifest+json .webmanifest

# caching: HTML always fresh; CSS and JS are versioned by ?v= in the pages; fonts never
# change; frames and images are unversioned (P8), so a month
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
